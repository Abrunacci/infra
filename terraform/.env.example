# Copy to terraform/.env (git-ignored), fill in, then load it:
#   set -a; . ./.env; set +a
# Nothing here is ever committed.

# DigitalOcean: custom-scoped token (droplet, firewall, ssh_key, tag, project, monitoring, vpc, database: create/read/update/delete;
# database also view_credentials).
# Keep the read-only dependencies the control panel adds (actions, regions, sizes, image, snapshot).
DIGITALOCEAN_TOKEN=

# Cloudflare: API token with, on the abrunacci.dev zone only, Zone -> DNS -> Edit,
# Zone -> SSL and Certificates -> Edit (only to keep Universal SSL off),
# Zone -> Email Routing Rules -> Edit and Zone -> Zone Settings -> Edit (to turn Email Routing on);
# and, on this account only, Account -> Email Routing Addresses -> Edit.
CLOUDFLARE_API_TOKEN=
# Each domain's zone ID (projects.yml, domains), from the zone's overview page:
#   TF_VAR_cloudflare_zone_ids='{"abrunacci.dev"="<id>"}'
# One "<domain>"="<id>" per domain, separated by commas.
TF_VAR_cloudflare_zone_ids=
TF_VAR_cloudflare_account_id=

# Inbox that receives the domains' forwarded addresses (projects.yml, mail_forward). Never in the repo (it is public).
TF_VAR_email_forward_to=

# Address DigitalOcean sends the resource alerts to. It must belong to a verified user of the
# DigitalOcean team. Never in the repo (it is public).
TF_VAR_alert_email=

# Tailscale: OAuth client with Policy File: Write and Auth Keys: Write, tag tag:terraform (it owns tag:prod and tag:ci).
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=

# Cloudflare R2: S3 credentials for an API token with Object Read & Write on the infra-tfstate bucket only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://<account_id>.r2.cloudflarestorage.com

# Not Terraform's: the secret the playbook derives each server's status page token from (64 hex characters).
# Generate it once, without printing it: printf 'GATUS_REMOTE_PUSH_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
GATUS_REMOTE_PUSH_SECRET=
# Public key installed for the admin user (not a secret, but kept out of the repo).
# TF_VAR_admin_ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
TF_VAR_admin_ssh_public_key=
