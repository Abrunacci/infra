# Copy to terraform/.env (git-ignored), fill in, then load it:
#   set -a; . ./.env; set +a
# Nothing here is ever committed.

# DigitalOcean: custom-scoped token (droplet, firewall, ssh_key, tag, project: create/read/update/delete).
# Keep the read-only dependencies the control panel adds (actions, regions, sizes, image, vpc).
DIGITALOCEAN_TOKEN=

# Cloudflare: API token with Zone -> DNS -> Edit and Zone -> SSL and Certificates -> Edit,
# both restricted to the abrunacci.dev zone (SSL is needed only to keep Universal SSL off).
CLOUDFLARE_API_TOKEN=
TF_VAR_cloudflare_zone_id=

# Cloudflare R2: S3 credentials for an API token with Object Read & Write on the infra-tfstate bucket only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://<account_id>.r2.cloudflarestorage.com

# Public key installed for the admin user (not a secret, but kept out of the repo).
# TF_VAR_admin_ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
TF_VAR_admin_ssh_public_key=
