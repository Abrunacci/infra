# Copy to terraform/github/.env (git-ignored), fill in, keep it readable by you only, then load it
# from terraform/github:
#   cp .env.example .env && chmod 600 .env
#   set -a; . ./.env; set +a
# The token below can administer the repositories, so it stays out of ../.env, which every
# Terraform and Ansible run loads. Nothing here is ever committed.

# The state's R2 S3 credentials (AWS_*), from the main configuration's file. The path is relative
# to the directory you load this from, so load it from terraform/github.
. ../.env

# GitHub: fine-grained token "terraform github rulesets" (README.md, "Credentials"):
# Administration -> Read and write on the repositories in main.tf only.
GITHUB_TOKEN=
