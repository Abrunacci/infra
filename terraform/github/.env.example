# Copy to terraform/github/.env (git-ignored), fill in, keep it readable by you only, then load it:
#   cp .env.example .env && chmod 600 .env
#   set -a; . ./.env; set +a
# Only this configuration loads it: the token below can administer the repositories, so it stays
# out of ../.env, which every Terraform and Ansible run loads. Nothing here is ever committed.

# GitHub: fine-grained token "terraform github rulesets" (README.md, "Credentials"):
# Administration -> Read and write on the repositories in main.tf only.
GITHUB_TOKEN=

# Cloudflare R2: the same S3 credentials for the state as in ../.env (Object Read & Write on
# infra-tfstate only; they do not expire).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://<account_id>.r2.cloudflarestorage.com
