# Managed by Ansible (roles/gatus). If it stops, Gatus notices: the Log alerts
# heartbeat gets no push for {{ gatus_host_heartbeat }} and alerts by itself.
[Unit]
Description=Email the log lines worth an alert ({{ gatus_host_check_calendar }})

[Timer]
OnCalendar={{ gatus_host_check_calendar }}
AccuracySec=10s

[Install]
WantedBy=timers.target
