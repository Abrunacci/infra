{# Read by server-posture (scripts/server-posture): what the server's security
   settings must be, from the roles that set each one up. The private paths
   it checks are in /etc/infra/projects.json (roles/projects), so that
   `--tags projects` updates them with Caddy's sites. #}
{%- set web_rules = hardening_ufw_web -%}
{#- Ubuntu 24.04 may start sshd by socket activation: then systemd holds port 22. #}
{%- set processes = {'SSH': ['sshd', 'systemd'], 'Tailscale': ['tailscaled']} -%}
{
  "listeners": [
{%- for r in hardening_ufw_rules %}
    {"proto": {{ r.proto | to_json }}, "port": {{ r.port | int }}, "processes": {{ processes[r.comment] | default(['docker-proxy']) | to_json }}}{{ '' if loop.last else ',' }}
{%- endfor %}
  ],
  "published": {
    "public": [{"service": "caddy/caddy", "ports": {{ web_rules | map(attribute='port') | zip(web_rules | map(attribute='proto')) | map('join', '/') | list | to_json }}}],
    {#- Gatus runs on the first server only. #}
    "loopback": {{ ([{"service": "gatus/gatus", "ports": [gatus_push_port ~ '/tcp']}] if is_first_server else []) | to_json }}
  },
  {#- "22/tcp", or "22/tcp on tailscale0" for a rule on one interface. #}
  "ufw": [{% for r in hardening_ufw_rules %}{{ (r.port ~ '/' ~ r.proto ~ ((' on ' ~ r.interface) if r.interface is defined else '')) | to_json }}{{ '' if loop.last else ', ' }}{% endfor %}],
  {#- tailscaled's own sockets on its addresses (100.64.0.0/10, fd7a:115c:a1e0::/48) are expected. #}
  "tailscale": {{ ssh_via_tailscale | bool | to_json }},
  "sshd": {
    "permitrootlogin": "no",
    "passwordauthentication": "no",
    "kbdinteractiveauthentication": "no",
    "authenticationmethods": "publickey",
    "allowusers": {{ hardening_ssh_allow_users | to_json }},
    "maxauthtries": "3"
  },
  "services": ["fail2ban", "unattended-upgrades"],
  "fail2ban_jails": {{ gatus_posture_fail2ban_jails | to_json }},
  "reboot_required_max_hours": {{ gatus_posture_reboot_max_hours | int }},
  "held_packages": {{ docker_held_packages | to_json }}
}
