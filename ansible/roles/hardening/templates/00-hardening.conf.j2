# Managed by Ansible (roles/hardening). Created by cloud-init on the first boot.
# "00-" sorts first, and sshd keeps the first value it reads for each option.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
AllowUsers {{ hardening_ssh_allow_users | join(' ') }}
MaxAuthTries 3
LoginGraceTime 30
X11Forwarding no
AllowAgentForwarding no
# Exception for admin_user: 10-forwarding.conf.
AllowTcpForwarding no
# Unix socket forwarding is separate from TCP forwarding and on by default.
AllowStreamLocalForwarding no
PermitTunnel no
