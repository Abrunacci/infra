# Managed by Ansible (roles/postgres). Local changes are overwritten.
name: postgres

services:
  postgres:
    image: {{ postgres_image }}
    restart: unless-stopped
    # Starts directly as postgres: the image's entrypoint then skips the
    # root-to-postgres switch, so no capability is needed.
    user: "{{ postgres_container_uid }}:{{ postgres_container_uid }}"
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    # Parallel queries use shared memory; Docker's default is 64 MB.
    shm_size: 256m
    # Enough time for a clean shutdown (checkpoint) before Docker kills it.
    stop_grace_period: 60s
    command:
      - postgres
      - -c
      - shared_buffers={{ postgres_shared_buffers }}
      - -c
      - effective_cache_size={{ postgres_effective_cache_size }}
      - -c
      - max_connections={{ postgres_max_connections }}
    environment:
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
    secrets:
      - postgres_password
    volumes:
      - postgres_data:/var/lib/postgresql/data
    # No published port: reachable only from containers on the internal db
    # network, always at the same address.
    networks:
      db:
        ipv4_address: {{ postgres_ipv4_address }}
    mem_limit: {{ postgres_memory_limit }}
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres", "-d", "postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

secrets:
  postgres_password:
    file: {{ postgres_password_file }}

volumes:
  # Fixed name, so it does not depend on the compose project name.
  postgres_data:
    name: postgres_data

networks:
  db:
    external: true
