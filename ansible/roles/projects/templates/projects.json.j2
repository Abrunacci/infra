{#- Managed by Ansible (roles/projects), from projects.yml. -#}
{%- set entries = [] -%}
{%- for p in projects_registry.projects -%}
{%-   set _ = entries.append({
        'name': p.name,
        'subdomain': p.subdomain | default(none),
        'title': p.title | default(p.name),
        'repo': p.repo | default(none),
        'site': p.site,
        'database': p.database,
        'database_name': (p.name | replace('-', '_')) if p.database else none,
        'deploy_key': p.deploy_key | default(none),
        'backend': {
          'image': p.backend.image,
          'port': p.backend.port | default(none),
          'health': p.backend.health | default(none),
          'secrets': p.backend.secrets | default({}) | dict2items | rejectattr('value', 'mapping')
                     | items2dict,
          'links': p.backend.secrets | default({}) | dict2items | selectattr('value', 'mapping')
                   | items2dict,
          'migrate': p.backend.migrate is defined,
          'database_url_scheme': p.backend.database_url_scheme | default('postgresql'),
        } if p.backend is defined else none,
      }) -%}
{%- endfor -%}
{{ {'projects': entries} | to_nice_json(sort_keys=true, ensure_ascii=false) }}
