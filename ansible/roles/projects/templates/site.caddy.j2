# Managed by Ansible (roles/projects), from projects.yml: {{ item.name }}.
{{ domain if item.subdomain == '@' else item.subdomain ~ '.' ~ domain }} {
	# Defined in the main Caddyfile (roles/caddy).
	import access_log
	encode zstd gzip

	# Applied after the response is written (defer), so they replace a
	# backend's own values instead of being added next to them. The ones with
	# ? are defaults: a backend that sends a stricter policy keeps it.
	# Permissions-Policy is the project's (permissions_policy in projects.yml)
	# or roles/caddy's default, for the static site and the backend alike.
	# Referrer-Policy and Content-Security-Policy set in projects.yml
	# (referrer_policy, content_security_policy) are forced like it.
	header {
		defer
		Strict-Transport-Security "{{ caddy_hsts }}"
		X-Content-Type-Options "nosniff"
{% if item.referrer_policy is defined %}
		Referrer-Policy "{{ item.referrer_policy }}"
{% else %}
		?Referrer-Policy "strict-origin-when-cross-origin"
{% endif %}
		# No other site may frame this one (clickjacking). X-Frame-Options says
		# the same to browsers too old for frame-ancestors; newer ones follow
		# the CSP when both are present.
{% if item.content_security_policy is defined %}
		Content-Security-Policy "{{ item.content_security_policy }}"
{% else %}
		?Content-Security-Policy "frame-ancestors 'none'"
{% endif %}
		?X-Frame-Options "DENY"
		Permissions-Policy "{{ item.permissions_policy | default(caddy_permissions_policy) }}"
		-Server
	}
{% if item.backend is defined %}
{%   set backend %}
{%     if item.backend.private_paths is defined %}
		# Only other containers on the server may call these: from the
		# internet they do not exist.
		@private path {{ item.backend.private_paths | join(' ') }}
		respond @private 404
{%     endif %}
		request_body {
			max_size {{ item.backend.max_body | default(projects_backend_default_max_body) }}
		}
		# The container's alias on the edge network. While it is recreated
		# (a deploy or a rollback), requests wait for it instead of failing.
		reverse_proxy {{ item.name }}-backend:{{ item.backend.port }} {
			lb_try_duration 15s
			lb_try_interval 250ms
		}
{%   endset %}
{% endif %}
{% if item.site and item.backend is defined %}

	# The backend's paths. Everything else is the static site below.
	@backend path {{ item.backend.paths | join(' ') }}
	handle @backend {
{{ backend }}	}
{% elif item.backend is defined %}

	# No static site: every path goes to the backend.
	handle {
{{ backend }}	}
{% endif %}
{% if item.site %}

	handle {
		root * {{ projects_sites_dir }}/{{ item.name }}/current

		# Files under /assets/ carry a content hash in their name (Vite), so they
		# never change; everything else is revalidated on each visit. A missing
		# asset is not cached: after a rollback, a newer release may need it again.
		@assets {
			path /assets/*
			file
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@not_assets not {
			path /assets/*
			file {path} {path}/index.html
		}
		header @not_assets Cache-Control "no-cache"

		# Single-page app: a path that is neither a file nor a folder with its
		# own index.html gets /index.html. Such a folder (dist/es/index.html) is
		# left to file_server, which serves /es/ from it and redirects /es to
		# /es/. A missing asset stays a 404 instead of returning HTML.
		@spa {
			not path /assets/*
			not file {path} {path}/index.html
		}
		rewrite @spa /index.html

		file_server
	}
{% endif %}
}
{% if item.subdomain == '@' and item.site %}

# The root domain's project also answers on www, only to send visitors to the
# root domain, keeping the path and query string.
www.{{ domain }} {
	import access_log
	header {
		Strict-Transport-Security "{{ caddy_hsts }}"
		-Server
	}
	redir https://{{ domain }}{uri} permanent
}
{% endif %}
