# Managed by Ansible (roles/projects), from projects.yml: {{ item.name }}.
# The image comes from the deployed release, never from this file:
#   docker compose --project-directory {{ projects_backends_dir }}/{{ item.name }} \
#     --env-file {{ projects_backends_state_dir }}/{{ item.name }}/release.env ...
# deploy-backend, backend-rollback and the playbook always pass that file.
name: backend-{{ item.name }}
{# The projects this backend links to (secrets {from: PROJECT, ...}). #}
{% set link_targets = (item.backend.secrets | default({})).values() | select('mapping') | map(attribute='from') | unique | sort | list %}
{% set worker = item.backend.worker | default(none) %}
{# A managed database (projects.yml, servers): no db-<name> network. The
   backend and the worker reach the cluster through their route out, and the
   migrations through db-egress, which reaches only the cluster. #}
{% set managed = item.database and database_managed %}

services:
  backend:
    image: ${BACKEND_IMAGE:?no release deployed yet}
    restart: unless-stopped
    # A minimal init as PID 1 passes SIGTERM on (an app running as PID 1 may
    # ignore it, and then waits out stop_grace_period) and reaps zombies.
    init: true
    # The backends user, whatever the image declares: never root.
    user: "{{ projects_backends_uid }}:{{ projects_backends_uid }}"
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
{% if item.subdomain is defined %}
    # The image's own HEALTHCHECK is turned off: nothing reads it, since the
    # health path through Caddy is what deploys, rollbacks and Gatus check,
    # and each run (often a new Python interpreter) costs CPU. An
    # internal backend keeps it: it is that backend's only health.
    healthcheck:
      disable: true
{% endif %}
    # Taken literally (format: raw): no quotes, escapes or comments.
    env_file:
      - path: {{ projects_backends_dir }}/{{ item.name }}/app.env
        format: raw
{% if worker %}
      # secrets.env without the worker's own secrets, written from it before
      # each start (backend_up in backend-lib.sh).
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/secrets-backend.env
        format: raw
{% else %}
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/secrets.env
        format: raw
{% endif %}
      # Copies of other projects' secrets ({from: ...}), written by project-secret.
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/links.env
        format: raw
{% if item.database %}
      # DATABASE_URL and DATABASE_DIRECT_URL, as the app's role (project-db).
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/database-app.env
        format: raw
{% endif %}
{% if managed %}
    # The managed cluster's CA, which its URLs name (sslrootcert, verify-full).
    volumes:
      - {{ projects_database_ca }}:{{ projects_database_ca_in_container }}:ro
{% endif %}
{% if item.subdomain is defined %}
    # No published port: Caddy reaches it by this alias on the project's own
    # network (edge-{{ item.name }}), which no other backend joins. It is also
    # its route out to the internet.
    networks:
      edge:
        aliases:
          - {{ item.name }}-backend
{% else %}
    # Internal (no subdomain): on no edge network, so neither Caddy nor the
    # other backends reach it. Its own network, only for its route out to the internet.
    networks:
      outbound: {}
{% endif %}
{% if item.database and not managed %}
      # PostgreSQL, as {{ postgres_host }}, on this project's own network
      # (db-{{ item.name }}), which no other backend joins. Internal: no route out.
      db: {}
{% endif %}
{% if item.name in link_receivers %}
      # Backends that link to this one reach it here, by the same alias.
      # Internal, and shared only with them.
      link-self:
        aliases:
          - {{ item.name }}-backend
{% endif %}
{% for target in link_targets %}
      # {{ target }}'s backend, as {{ target }}-backend: a secret links to it.
      link-{{ target }}: {}
{% endfor %}
    mem_limit: {{ item.backend.memory | default(projects_backend_default_memory) | memory_limit(ansible_memtotal_mb) }}
    memswap_limit: {{ item.backend.memory | default(projects_backend_default_memory) | memory_limit(ansible_memtotal_mb) }}
    cpus: {{ item.backend.cpus | default(projects_backend_default_cpus) }}
    pids_limit: 256
    stop_grace_period: 20s
    labels:
      infra.release: ${BACKEND_RELEASE:-}
    # To the systemd journal, which outlives the container: a deploy or a
    # restart no longer loses the previous log. Read it with
    # `sudo journalctl -t backend.{{ item.name }}`, or `sudo docker logs` (only
    # the current container). May hold personal data; the journal's size cap
    # bounds how long it stays (roles/base, ansible/README.md "Backend logs").
    logging:
      driver: journald
      options:
        tag: backend.{{ item.name }}
{% if worker %}

  # A second process of the same image and release (worker in projects.yml):
  # every deploy, rollback and restart moves it with the backend, and waits
  # for its health command. No port and no alias: neither Caddy nor any
  # backend reaches it.
  worker:
    image: ${BACKEND_IMAGE:?no release deployed yet}
    command: {{ worker.command | to_json }}
    restart: unless-stopped
    init: true
    user: "{{ projects_backends_uid }}:{{ projects_backends_uid }}"
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    # Its own check instead of the image's, which is the backend's. Each run
    # is a new process that loads the app: EPB's takes about 18 s with half a
    # CPU, so it gets 60 s, and runs every 5 s only while the worker starts
    # (a deploy waits for the first pass), then every 5 minutes, so it does
    # not eat the worker's CPU. Unhealthy after two failures in a row.
    healthcheck:
      test: {{ (['CMD'] + worker.health) | to_json }}
      interval: 5m
      timeout: 60s
      retries: 2
      start_period: 2m
      start_interval: 5s
    env_file:
      - path: {{ projects_backends_dir }}/{{ item.name }}/app.env
        format: raw
      # Only the secrets it lists, written from secrets.env before each start.
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/secrets-worker.env
        format: raw
{% if item.database %}
      # DATABASE_URL, as the app's role, like the backend.
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/database-app.env
        format: raw
{% endif %}
{% if managed %}
    volumes:
      - {{ projects_database_ca }}:{{ projects_database_ca_in_container }}:ro
{% endif %}
    networks:
      # Its own network, only for its route out to the internet.
      worker-outbound: {}
{% if item.database and not managed %}
      db: {}
{% endif %}
    mem_limit: {{ worker.memory | memory_limit(ansible_memtotal_mb) }}
    memswap_limit: {{ worker.memory | memory_limit(ansible_memtotal_mb) }}
    # Its own, or else the backend's. Its health command runs in this
    # container too, and shares this limit with the worker.
    cpus: {{ worker.cpus | default(item.backend.cpus | default(projects_backend_default_cpus)) }}
    pids_limit: 256
    stop_grace_period: {{ worker.stop_grace_period | default('20s') }}
    labels:
      infra.release: ${BACKEND_RELEASE:-}
    # `sudo journalctl -t backend.{{ item.name }}-worker`, like the backend's.
    logging:
      driver: journald
      options:
        tag: backend.{{ item.name }}-worker
{% endif %}
{% if item.backend.migrate is defined %}

  # Run once per deploy by deploy-backend (docker compose run --rm migrate),
  # with the new image, before the backend switches to it. Only the public
  # env and the owner's connection: none of the app's secrets, and no route
{% if managed %}
  # out of {{ db_egress_network }}, which reaches only the managed cluster.
{% else %}
  # out of the project's db-<name> network.
{% endif %}
  migrate:
    image: ${BACKEND_IMAGE:?no image given}
    profiles:
      - migrate
    command: {{ item.backend.migrate | to_json }}
    restart: "no"
    init: true
    user: "{{ projects_backends_uid }}:{{ projects_backends_uid }}"
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    env_file:
      - path: {{ projects_backends_dir }}/{{ item.name }}/app.env
        format: raw
      # MIGRATION_DATABASE_URL (the owner) and APP_DB_USER (project-db).
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/database-migrate.env
        format: raw
{% if managed %}
    volumes:
      - {{ projects_database_ca }}:{{ projects_database_ca_in_container }}:ro
    # db-egress answers no DNS: the cluster's address, which deploy-backend
    # resolves on the server just before (DATABASE_HOST_IP). Without it, an
    # address nothing answers on (TEST-NET-1), so nothing is reached.
    extra_hosts:
      - "{{ projects_managed_db.host }}=${DATABASE_HOST_IP:-192.0.2.1}"
    networks:
      - egress
{% else %}
    networks:
      - db
{% endif %}
    mem_limit: {{ item.backend.memory | default(projects_backend_default_memory) | memory_limit(ansible_memtotal_mb) }}
    memswap_limit: {{ item.backend.memory | default(projects_backend_default_memory) | memory_limit(ansible_memtotal_mb) }}
    cpus: {{ item.backend.cpus | default(projects_backend_default_cpus) }}
    pids_limit: 256
{% endif %}

networks:
{% if worker %}
  # Created and removed by Compose with the backend (backend-{{ item.name }}_worker-outbound).
  worker-outbound: {}
{% endif %}
{% if item.subdomain is defined %}
  # Created by roles/caddy.
  edge:
    name: edge-{{ item.name }}
    external: true
{% else %}
  # Created and removed by Compose with the backend (backend-{{ item.name }}_outbound).
  outbound: {}
{% endif %}
{% if managed %}
  # Created by roles/docker.
  egress:
    name: {{ db_egress_network }}
    external: true
{% elif item.database %}
  # Created by roles/postgres.
  db:
    name: db-{{ item.name }}
    external: true
{% endif %}
{% if item.name in link_receivers %}
  # Created by roles/projects.
  link-self:
    name: link-{{ item.name }}
    external: true
{% endif %}
{% for target in link_targets %}
  link-{{ target }}:
    external: true
{% endfor %}
