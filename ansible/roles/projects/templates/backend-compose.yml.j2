# Managed by Ansible (roles/projects), from projects.yml: {{ item.name }}.
# The image comes from the deployed release, never from this file:
#   docker compose --project-directory {{ projects_backends_dir }}/{{ item.name }} \
#     --env-file {{ projects_backends_state_dir }}/{{ item.name }}/release.env ...
# deploy-backend, backend-rollback and the playbook always pass that file.
name: backend-{{ item.name }}
{# The projects this backend links to (secrets {from: PROJECT, ...}). #}
{% set link_targets = (item.backend.secrets | default({})).values() | select('mapping') | map(attribute='from') | unique | sort | list %}

services:
  backend:
    image: ${BACKEND_IMAGE:?no release deployed yet}
    restart: unless-stopped
    # A minimal init as PID 1 passes SIGTERM on (an app running as PID 1 may
    # ignore it, and then waits out stop_grace_period) and reaps zombies.
    init: true
    # The backends user, whatever the image declares: never root.
    user: "{{ projects_backends_uid }}:{{ projects_backends_uid }}"
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    # Taken literally (format: raw): no quotes, escapes or comments.
    env_file:
      - path: {{ projects_backends_dir }}/{{ item.name }}/app.env
        format: raw
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/secrets.env
        format: raw
      # Copies of other projects' secrets ({from: ...}), written by project-secret.
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/links.env
        format: raw
{% if item.database %}
      # DATABASE_URL, as the app's role (project-db).
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/database-app.env
        format: raw
{% endif %}
{% if item.subdomain is defined %}
    # No published port: Caddy reaches it by this alias on the project's own
    # network (edge-{{ item.name }}), which no other backend joins. It is also
    # its route out to the internet.
    networks:
      edge:
        aliases:
          - {{ item.name }}-backend
{% else %}
    # Internal (no subdomain): on no edge network, so neither Caddy nor the
    # other backends reach it. Its own network, only for its route out to the internet.
    networks:
      outbound: {}
{% endif %}
{% if item.database %}
      # PostgreSQL, at its fixed address. Internal: no route out.
      db: {}
{% endif %}
{% if item.name in link_receivers %}
      # Backends that link to this one reach it here, by the same alias.
      # Internal, and shared only with them.
      link-self:
        aliases:
          - {{ item.name }}-backend
{% endif %}
{% for target in link_targets %}
      # {{ target }}'s backend, as {{ target }}-backend: a secret links to it.
      link-{{ target }}: {}
{% endfor %}
    mem_limit: {{ item.backend.memory | default(projects_backend_default_memory) }}
    memswap_limit: {{ item.backend.memory | default(projects_backend_default_memory) }}
    pids_limit: 256
    stop_grace_period: 20s
    labels:
      infra.release: ${BACKEND_RELEASE:-}
{% if item.backend.migrate is defined %}

  # Run once per deploy by deploy-backend (docker compose run --rm migrate),
  # with the new image, before the backend switches to it. Only the public
  # env and the owner's connection: none of the app's secrets, and no route
  # out of the db network.
  migrate:
    image: ${BACKEND_IMAGE:?no image given}
    profiles:
      - migrate
    command: {{ item.backend.migrate | to_json }}
    restart: "no"
    init: true
    user: "{{ projects_backends_uid }}:{{ projects_backends_uid }}"
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    env_file:
      - path: {{ projects_backends_dir }}/{{ item.name }}/app.env
        format: raw
      # MIGRATION_DATABASE_URL (the owner) and APP_DB_USER (project-db).
      - path: {{ projects_backends_secrets_dir }}/{{ item.name }}/database-migrate.env
        format: raw
    networks:
      - db
    mem_limit: {{ item.backend.memory | default(projects_backend_default_memory) }}
    memswap_limit: {{ item.backend.memory | default(projects_backend_default_memory) }}
    pids_limit: 256
{% endif %}

networks:
{% if item.subdomain is defined %}
  # Created by roles/caddy.
  edge:
    name: edge-{{ item.name }}
    external: true
{% else %}
  # Created and removed by Compose with the backend (backend-{{ item.name }}_outbound).
  outbound: {}
{% endif %}
{% if item.database %}
  db:
    external: true
{% endif %}
{% if item.name in link_receivers %}
  # Created by roles/projects.
  link-self:
    name: link-{{ item.name }}
    external: true
{% endif %}
{% for target in link_targets %}
  link-{{ target }}:
    external: true
{% endfor %}
