# Managed by Ansible (roles/caddy). Local changes are overwritten.
name: caddy

services:
  caddy:
    image: {{ caddy_image }}
    restart: unless-stopped
    user: "{{ caddy_uid }}:{{ caddy_uid }}"
    read_only: true
    tmpfs:
      - /tmp
    # The only capability kept. Docker already lets any user bind ports below
    # 1024 inside the container, but the caddy binary carries this file
    # capability, and without it in the bounding set the kernel refuses to run it.
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    # The only published ports on the server. Docker's published ports bypass
    # ufw, so nothing else may be published (PostgreSQL is not).
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./conf:/etc/caddy:ro
      - ./data:/data
      - ./config:/config
    networks:
      - edge
    mem_limit: {{ caddy_memory_limit }}
    # The admin API listens on localhost inside the container only.
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2019/config/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

networks:
  edge:
    external: true
