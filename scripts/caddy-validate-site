#!/usr/bin/env bash
# Checks a candidate site file together with the rest of Caddy's config,
# before it replaces the current one. Used by Ansible's `validate`:
#   caddy-validate-site IMAGE UID CONF_DIR CANDIDATE NAME
# CONF_DIR is copied, CANDIDATE takes the place of sites/NAME.caddy in the
# copy, and Caddy validates the result in a throwaway container with the same
# restrictions it runs with. The live config is never touched.
# Installed by Ansible (roles/caddy) as /usr/local/sbin/caddy-validate-site.
set -euo pipefail

if [[ $# -ne 5 ]]; then
  echo "usage: caddy-validate-site IMAGE UID CONF_DIR CANDIDATE NAME" >&2
  exit 2
fi
image=$1 uid=$2 conf=$3 candidate=$4 name=$5
[[ "$name" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || { echo "invalid site name: $name" >&2; exit 2; }
[[ "$uid" =~ ^[0-9]+$ ]] || { echo "invalid uid: $uid" >&2; exit 2; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
cp -a "$conf/." "$tmp/"
mkdir -p "$tmp/sites"
cp "$candidate" "$tmp/sites/$name.caddy"
# Caddy runs as $uid in the container: let it read the copy.
chmod -R a+rX "$tmp"

docker run --rm --network none --read-only --user "$uid:$uid" \
  --cap-drop ALL --cap-add NET_BIND_SERVICE --security-opt no-new-privileges \
  -v "$tmp:/etc/caddy:ro" \
  "$image" caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
