#!/usr/bin/env bash
# Stores the credentials Gatus sends its alerts with, and checks them by
# sending a test email; or the ping URL of the check outside the server.
#
#   sudo gatus-credentials
#   sudo gatus-credentials healthchecks
#
# For the email channel, it asks for a Resend API key (sending access, on the
# mail domain only; see ansible/README.md, "Status page and alerts") without
# showing it, and sends a test email through Resend's SMTP server to the alert
# address, with the same settings Gatus uses. Only if Resend accepts it is the
# key written to /etc/infra/secrets/gatus/email.env (root only); otherwise the
# previous one is kept. The key never appears on a command line or in any
# output. If Gatus is running, it is then recreated to use the new key. Run it
# again to replace the key.
#
# With healthchecks, it asks for the ping URL of the server's check on
# healthchecks.io (see ansible/README.md, "Status page and alerts"), without
# showing it, and sends one ping with it. Only if healthchecks.io answers OK is
# it written to /etc/infra/secrets/gatus/healthchecks.env (root only), where
# gatus-heartbeats reads it on its next run; otherwise the previous one is
# kept. Anyone with the URL can report the server as up, so it is handled like
# the key: never on a command line or in any output.
# Installed by Ansible (roles/gatus) as /usr/local/sbin/gatus-credentials.
set -euo pipefail
umask 077
export LC_ALL=C
cd /

fail() {
  echo "gatus-credentials: $*" >&2
  exit 1
}

conf=/etc/infra/gatus.conf
[[ "$EUID" -eq 0 ]] || fail "run it with sudo"
[[ $# -eq 0 || ( $# -eq 1 && "$1" == healthchecks ) ]] \
  || { echo "usage: sudo gatus-credentials [healthchecks]" >&2; exit 2; }
[[ -r "$conf" ]] || fail "$conf is missing (run the playbook)"
# shellcheck source=/dev/null
. "$conf"

if [[ "${1:-}" == healthchecks ]]; then
  [[ -t 0 ]] || fail "it asks for the ping URL: run it in a terminal"
  IFS= read -rs -p "healthchecks.io ping URL (not shown): " url
  echo >&2
  url="${url//[[:space:]]/}"
  uuid='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
  [[ "$url" == "$HEALTHCHECKS_PING_BASE/"* && "${url#"$HEALTHCHECKS_PING_BASE/"}" =~ ^${uuid}$ ]] \
    || fail "a ping URL looks like $HEALTHCHECKS_PING_BASE/<uuid>; nothing was changed"
  # The URL reaches curl through its config on stdin, never as an argument.
  out="$(printf 'url = "%s"\n' "$url" \
    | curl --silent --show-error --max-time 30 --config - --data-raw "Ping URL stored by gatus-credentials" 2>&1)" \
    || out="not reached: $(tail -n 1 <<<"$out")"
  if [[ "$out" != OK ]]; then
    url=""
    fail "healthchecks.io did not take the test ping ($(tr -cd '[:print:]' <<<"$out" | cut -c1-160)); nothing was changed"
  fi
  install -d -m 0700 -o root -g root "$GATUS_SECRETS_DIR"
  tmp="$(mktemp "$GATUS_SECRETS_DIR/.healthchecks.env.XXXXXX")"
  printf 'HEALTHCHECKS_PING_URL=%s\n' "$url" >"$tmp"
  url=""
  mv -f "$tmp" "$GATUS_SECRETS_DIR/healthchecks.env"
  logger -t gatus -- "healthchecks ping URL replaced by=${SUDO_USER:-root}" 2>/dev/null || true
  echo "Stored. healthchecks.io took a test ping: the check shows as up there."
  echo "gatus-heartbeats pings it from its next run (every 5 minutes)."
  exit 0
fi
[[ "$GATUS_ALERT_CHANNEL" == email ]] || fail "the alert channel is $GATUS_ALERT_CHANNEL; this command only knows email"
[[ -t 0 ]] || fail "it asks for the API key: run it in a terminal"

to="$(sed -n 's/^ALERT_EMAIL_TO=//p' "$GATUS_SECRETS_DIR/alerts.env" 2>/dev/null || true)"
[[ -n "$to" ]] || fail "$GATUS_SECRETS_DIR/alerts.env has no ALERT_EMAIL_TO (run the playbook)"

IFS= read -rs -p "Resend API key (not shown): " key
echo >&2
key="${key//[[:space:]]/}"
[[ "$key" =~ ^re_[A-Za-z0-9_]{16,}$ ]] || fail "a Resend API key starts with re_; nothing was changed"

msg="$(mktemp)"
trap 'rm -f "$msg"' EXIT
printf '%s\r\n' \
  "From: Status <$SMTP_FROM>" \
  "To: <$to>" \
  "Subject: Status page: test email" \
  "Date: $(date -R)" \
  "Message-ID: <gatus-credentials.$(date +%s).$$@${SMTP_FROM#*@}>" \
  "" \
  "Sent by gatus-credentials on $(hostname) to check the key Gatus sends its alerts with." \
  "If this arrived, the alerts will too." >"$msg"

# STARTTLS is required (--ssl-reqd), and the certificate is verified. The key
# reaches curl through its config on stdin, never as an argument.
if ! out="$(curl --silent --show-error --max-time 30 --ssl-reqd \
  --url "smtp://$SMTP_HOST:$SMTP_PORT" --mail-from "$SMTP_FROM" --mail-rcpt "$to" \
  --upload-file "$msg" --config - <<<"user = \"$SMTP_USERNAME:$key\"" 2>&1)"; then
  key=""
  fail "Resend did not accept the test email ($(tail -n 1 <<<"$out" | tr -cd '[:print:]' | cut -c1-160)); nothing was changed"
fi

install -d -m 0700 -o root -g root "$GATUS_SECRETS_DIR"
tmp="$(mktemp "$GATUS_SECRETS_DIR/.email.env.XXXXXX")"
printf 'SMTP_PASSWORD=%s\n' "$key" >"$tmp"
key=""
mv -f "$tmp" "$GATUS_SECRETS_DIR/email.env"
logger -t gatus -- "email credentials replaced by=${SUDO_USER:-root}" 2>/dev/null || true
echo "Stored. Resend accepted a test email to the alert address: check that it arrived."

# A running Gatus reads its environment only when created.
if [[ -n "$(docker compose --file "$GATUS_DIR/compose.yml" ps --quiet gatus 2>/dev/null)" ]]; then
  docker compose --progress quiet --file "$GATUS_DIR/compose.yml" up --detach --force-recreate --wait gatus >/dev/null
  echo "Gatus was recreated with the new key."
fi
