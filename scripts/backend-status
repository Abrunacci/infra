#!/usr/bin/env bash
# Shows a project's backend: the deployed release, its container and whether
# its health path answers (from Caddy's container, like requests), or, for an
# internal backend, whether Docker reports it healthy (the image's HEALTHCHECK).
# With a worker, also its container, which must be healthy too, and its last
# health commands: when, how long, the exit status and what each printed.
#
#   sudo backend-status PROJECT           check once
#   sudo backend-status PROJECT --wait    keep checking for up to 60 s (the playbook
#                                         uses it after recreating a container)
#
# Exit status: 0 healthy, 1 not healthy, 3 nothing deployed yet.
# Installed by Ansible (roles/projects) as /usr/local/sbin/backend-status.
set -euo pipefail
export LC_ALL=C
# shellcheck source=scripts/backend-lib.sh
. /usr/local/lib/infra/backend.sh

# One line per health command: start (UTC), duration, exit status (-1 when
# Docker's timeout stopped it) and the start of its output.
readonly WORKER_CHECKS_FORMAT=$'{{if .State.Health}}{{range .State.Health.Log}}           {{.Start.UTC.Format "2006-01-02T15:04:05Z"}}  {{(.End.Sub .Start).Round 100000000}}  exit {{.ExitCode}}  output: {{printf "%.200s" (json .Output)}}\n{{end}}{{end}}'

fail() {
  echo "backend-status: $*" >&2
  exit 1
}

[[ $# -eq 1 || ($# -eq 2 && "$2" == --wait) ]] || { echo "usage: sudo backend-status PROJECT [--wait]" >&2; exit 2; }
[[ "$EUID" -eq 0 ]] || fail "run it with sudo"
project="$1"
[[ "$project" =~ $NAME_RE ]] || fail "invalid project name"
backend_load "$project"

release="$(backend_current "$project" BACKEND_RELEASE)"
if [[ -z "$release" ]]; then
  echo "$project: nothing deployed yet"
  exit 3
fi
echo "release:   $release"
echo "image:     $(backend_current "$project" BACKEND_IMAGE)"
echo "container: $(backend_compose "$project" ps -a --format '{{.Name}} {{.State}} {{.Status}}' backend 2>/dev/null || echo unknown)"
if [[ "$BACKEND_WORKER" == true ]]; then
  echo "worker:    $(backend_compose "$project" ps -a --format '{{.Name}} {{.State}} {{.Status}}' worker 2>/dev/null || echo unknown)"
  # Docker keeps the last five; gatus-heartbeats copies each one to the
  # journal (backend-health) every 5 minutes, so the older ones are there.
  echo "checks:    (Docker's last five; older ones: sudo journalctl -t backend-health)"
  worker="$(backend_compose "$project" ps -a -q worker 2>/dev/null)" || worker=""
  [[ -n "$worker" ]] && docker inspect -f "$WORKER_CHECKS_FORMAT" "${worker%%$'\n'*}" 2>/dev/null || true
  echo "logs:      sudo journalctl -t backend.$project-worker -t backend-health --since -2h"
fi

seconds=0
[[ "${2:-}" == --wait ]] && seconds="$HEALTH_SECONDS"
if backend_healthy "$project" "$seconds"; then
  echo "health:    ok ($(backend_health_target "$project"))"
  exit 0
fi
echo "health:    NOT OK ($(backend_health_target "$project"))"
echo "log:       sudo journalctl -t backend.$project -n 50"
[[ "$BACKEND_WORKER" == true ]] && echo "           sudo journalctl -t backend.$project-worker -t backend-health --since -2h"
exit 1
