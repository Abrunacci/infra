#!/usr/bin/env bash
# Stores the password of the managed database cluster's admin user, and checks
# it. Only on a server whose database is managed (database: managed in
# projects.yml's servers; DATABASE_MODE=managed in /etc/infra/database.conf).
#
#   sudo database-credentials
#
# It asks for the password without showing it (in Terraform's state: from your
# machine, terraform -chdir=terraform output -raw production_db_password) and
# writes it to /etc/infra/secrets/database-admin.env (root only). It never
# appears on a command line or in any output. Then it connects with it, the way
# project-db and the backups do (a client container on the db-egress network,
# TLS verify-full against the cluster's CA), so a wrong value, a closed
# firewall or a certificate that does not match fail here. Run it again to
# replace it (after resetting the password in DigitalOcean).
# Installed by Ansible (roles/projects) as /usr/local/sbin/database-credentials.
set -euo pipefail
umask 077
export LC_ALL=C
cd /

fail() {
  echo "database-credentials: $*" >&2
  exit 1
}

# shellcheck source=scripts/backend-lib.sh
. /usr/local/lib/infra/backend.sh
[[ "$EUID" -eq 0 ]] || fail "run it with sudo"
[[ $# -eq 0 ]] || { echo "usage: sudo database-credentials" >&2; exit 2; }
[[ -t 0 ]] || fail "it asks for the password: run it in a terminal"
db_load_conf
[[ "$DATABASE_MODE" == managed ]] || fail "this server's database is PostgreSQL's container, which needs no password here"
[[ -s "$DATABASE_CA" ]] || fail "missing $DATABASE_CA (run the playbook)"

IFS= read -rs -p "Password of $POSTGRES_ADMIN_USER (not shown): " password
echo >&2
password="${password//[[:space:]]/}"
[[ "$password" =~ ^[[:graph:]]{16,128}$ ]] || fail "that does not look like the cluster's password (16 to 128 characters, no spaces); nothing was changed"

dir="$(dirname "$DATABASE_ADMIN_ENV")"
install -d -m 0700 -o root -g root "$dir"
tmp="$(mktemp "$dir/.database-admin.env.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
printf 'PGPASSWORD=%s\n' "$password" >"$tmp"
password=""

db_egress
if ! out="$(db_client "$tmp" "$POSTGRES_ADMIN_USER" psql -d defaultdb -AtqX -v ON_ERROR_STOP=1 \
  -c "SELECT current_user || ' ' || (SELECT ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid())" </dev/null 2>&1)"; then
  fail "the cluster refused it, or did not answer ($(tail -n 1 <<<"$out" | tr -cd '[:print:]' | cut -c1-200)); nothing was changed"
fi
[[ "$out" == "$POSTGRES_ADMIN_USER true" ]] || fail "unexpected answer from the cluster; nothing was changed"
mv -f "$tmp" "$DATABASE_ADMIN_ENV"
logger -t database -- "admin credentials replaced by=${SUDO_USER:-root}" 2>/dev/null || true
echo "Stored and checked: $POSTGRES_ADMIN_USER connects to $POSTGRES_HOST over TLS (verify-full)."
