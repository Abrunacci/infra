#!/usr/bin/env bash
# Stores the R2 credentials the backups are uploaded with, and checks them.
#
#   sudo backup-credentials
#
# It asks for the Access Key ID and the Secret Access Key of the "server
# backups" R2 token (Object Read & Write on the backups bucket only; see
# terraform/backup-bucket/README.md), without showing them, and writes them to
# /etc/infra/secrets/backup/r2.env (root only). They never appear on a command
# line or in any output. Then it lists the bucket with them, so a wrong value
# fails here and not at 03:30. Run it again to replace them (a new token
# before the old one expires).
# Installed by Ansible (roles/backup) as /usr/local/sbin/backup-credentials.
set -euo pipefail
umask 077
export LC_ALL=C
cd /

fail() {
  echo "backup-credentials: $*" >&2
  exit 1
}

# shellcheck source=scripts/backup-lib.sh
. /usr/local/lib/infra/backup.sh
[[ "$EUID" -eq 0 ]] || fail "run it with sudo"
[[ $# -eq 0 ]] || { echo "usage: sudo backup-credentials" >&2; exit 2; }
[[ -t 0 ]] || fail "it asks for the credentials: run it in a terminal"
backup_load

IFS= read -rs -p "Access Key ID (not shown): " key_id
echo >&2
IFS= read -rs -p "Secret Access Key (not shown): " secret
echo >&2
key_id="${key_id//[[:space:]]/}"
secret="${secret//[[:space:]]/}"
[[ "$key_id" =~ ^[0-9a-f]{32}$ ]] || fail "the Access Key ID is 32 hex characters; nothing was changed"
[[ "$secret" =~ ^[0-9a-f]{64}$ ]] || fail "the Secret Access Key is 64 hex characters; nothing was changed"

dir="$(dirname "$BACKUP_CREDENTIALS")"
install -d -m 0700 -o root -g root "$dir"
tmp="$(mktemp "$dir/.r2.env.XXXXXX")"
printf 'RCLONE_CONFIG_R2_ACCESS_KEY_ID=%s\nRCLONE_CONFIG_R2_SECRET_ACCESS_KEY=%s\n' "$key_id" "$secret" >"$tmp"
key_id="" secret=""
previous=""
[[ -f "$BACKUP_CREDENTIALS" ]] && previous="$BACKUP_CREDENTIALS.previous" && cp -p "$BACKUP_CREDENTIALS" "$previous"
mv -f "$tmp" "$BACKUP_CREDENTIALS"

if ! out="$(r2 lsf "r2:$BACKUP_BUCKET" --max-depth 1 </dev/null 2>&1)"; then
  if [[ -n "$previous" ]]; then mv -f "$previous" "$BACKUP_CREDENTIALS"; else rm -f "$BACKUP_CREDENTIALS"; fi
  fail "R2 refused them ($(tail -n 1 <<<"$out" | tr -cd '[:print:]' | cut -c1-160)); the previous credentials were kept"
fi
rm -f "$previous"
logger -t backup -- "credentials replaced by=${SUDO_USER:-root}" 2>/dev/null || true
echo "Stored and checked: the bucket answers with these credentials."
