#!/usr/bin/env bash
# Manages the secret environment variables of a project's backend. Only their
# names are in projects.yml (backend.secrets); the values live on the server,
# in /etc/infra/secrets/projects/PROJECT/secrets.env (root only), and never
# leave it except inside the encrypted backups.
#
#   sudo project-secret PROJECT list          declared names and whether each one has a value
#   sudo project-secret PROJECT set KEY       read the value from the terminal (not echoed) or stdin
#   sudo project-secret PROJECT unset KEY     remove a value
#   sudo project-secret PROJECT check         exit 1 unless every declared secret has a value
#                                             and nothing undeclared is set
#   sudo project-secret PROJECT generate KEY  create a random value if there is none (the
#                                             playbook runs it for "generated" secrets)
#   sudo project-secret PROJECT rotate KEY    replace a generated secret with a new random
#                                             value and restart the backend
#   sudo project-secret PROJECT sync          rewrite links.env, the copies of other
#                                             projects' secrets, from their sources (the
#                                             playbook runs it)
#
# Values are single lines, passed to the container exactly as typed. A change
# reaches the container when it is recreated: at the next deploy, or now with
# sudo backend-rollback PROJECT --restart. Values are never printed.
#
# A secret other backends link to ({from: PROJECT, key: KEY} in projects.yml)
# has one source, this project's secrets.env. Every change to it is copied to
# their links.env at once. After set or rotate, this backend and theirs are
# restarted together, so they never hold different values for long; a backend
# that was never deployed is skipped.
# Installed by Ansible (roles/projects) as /usr/local/sbin/project-secret.
set -euo pipefail
umask 077
export LC_ALL=C
# shellcheck source=scripts/backend-lib.sh
. /usr/local/lib/infra/backend.sh

fail() {
  echo "project-secret: $*" >&2
  exit 1
}

usage() {
  echo "usage: sudo project-secret PROJECT {list | check | sync | set KEY | unset KEY | generate KEY | rotate KEY}" >&2
  exit 2
}

[[ $# -ge 2 && $# -le 3 ]] || usage
[[ "$EUID" -eq 0 ]] || fail "run it with sudo"
project="$1" action="$2" key="${3:-}"
[[ "$project" =~ $NAME_RE ]] || fail "invalid project name"
case "$action" in
  list | check | sync) [[ $# -eq 2 ]] || usage ;;
  set | unset | generate | rotate) [[ $# -eq 3 ]] || usage ;;
  *) usage ;;
esac
backend_load "$project"
file="$SECRETS_DIR/$project/secrets.env"
[[ -f "$file" && ! -L "$file" ]] || fail "$file is missing (run the playbook)"

# The kind of KEY in projects.yml (generated or manual), or nothing.
declared_kind() {
  local line k kind
  for line in "${BACKEND_SECRETS[@]}"; do
    read -r k kind <<<"$line"
    [[ "$k" == "$1" ]] && { echo "$kind"; return 0; }
  done
}

has_value() {
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == "$1="* ]] && return 0
  done <"$file"
  return 1
}

# Rewrites the file without KEY, then with KEY=VALUE when a value is given.
# The new file replaces the old one in one rename.
write_key() {
  local k="$1" line tmp
  tmp="$(mktemp "$SECRETS_DIR/$project/.secrets.XXXXXX")"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == "$k="* ]] && continue
    printf '%s\n' "$line"
  done <"$file" >"$tmp"
  [[ $# -eq 2 ]] && printf '%s=%s\n' "$k" "$2" >>"$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$file"
}

# The backends that link to KEY of this project: "CONSUMER CONSUMER_KEY" lines.
consumers_of() {
  backend_consumers "$project" "$1"
}

# Copies KEY's new value (or its absence) to every backend that links to it.
# Each links.env is replaced in one rename. In a subshell: backend_read
# replaces the BACKEND_* variables of this project.
propagate() {
  local consumer _
  while read -r consumer _; do
    [[ -n "$consumer" ]] || continue
    (backend_load "$consumer" && backend_sync_links "$consumer" >/dev/null) \
      || fail "could not copy $1 to $consumer (sudo project-secret $consumer sync)"
    logger -t project-secret -- "project=$consumer synced-from=$project:$1"
  done < <(consumers_of "$1")
}

# Restarts this backend and every backend that links to KEY, the deployed
# ones only, once this command's lock is released (backend-rollback takes it).
restart_with_consumers() {
  local p consumer _ failed=0
  local -a targets=("$project")
  while read -r consumer _; do
    [[ -n "$consumer" ]] && targets+=("$consumer")
  done < <(consumers_of "$1")
  exec 9>&-
  for p in "${targets[@]}"; do
    if [[ ! -f "$STATE_DIR/$p/release.env" ]]; then
      echo "$p: not deployed yet, nothing to restart"
      continue
    fi
    /usr/local/sbin/backend-rollback "$p" --restart || failed=1
  done
  ((failed == 0)) || fail "a restart failed: sudo backend-status PROJECT for each one above"
}

if [[ -n "$key" ]]; then
  [[ "$key" =~ $KEY_RE ]] || fail "invalid name: $key"
fi

case "$action" in
  list)
    for line in "${BACKEND_SECRETS[@]}"; do
      read -r k kind <<<"$line"
      if has_value "$k"; then state="set"; else state="MISSING"; fi
      shared="$(consumers_of "$k" | awk '{print $1}' | paste -sd, -)"
      printf '%-32s %-9s %-7s %s\n' "$k" "$kind" "$state" "${shared:+copied to $shared}"
    done
    for line in "${BACKEND_LINKS[@]}"; do
      read -r k source source_key <<<"$line"
      if [[ -n "$(backend_env_value "$SECRETS_DIR/$project/links.env" "$k")" ]]; then state="set"; else state="MISSING"; fi
      printf '%-32s %-9s %-7s %s\n' "$k" linked "$state" "copy of $source's $source_key"
    done
    [[ ${#BACKEND_SECRETS[@]} -gt 0 || ${#BACKEND_LINKS[@]} -gt 0 ]] || echo "(no secrets declared in projects.yml)"
    backend_secret_problems "$project" >/dev/null || echo "Problems: sudo project-secret $project check"
    ;;
  check)
    problems="$(backend_secret_problems "$project")" && { echo "ok"; exit 0; }
    printf '%s\n' "$problems" >&2
    exit 1
    ;;
  set)
    [[ "$(declared_kind "$key")" == manual ]] \
      || fail "$key is not declared in projects.yml as a manual secret of $project"
    backend_lock "$project"
    if [[ -t 0 ]]; then
      IFS= read -rs -p "Value for $key (not shown): " value
      echo >&2
    else
      IFS= read -r value || [[ -n "${value:-}" ]] || fail "no value on stdin"
    fi
    [[ -n "$value" ]] || fail "empty value; nothing was changed"
    [[ "$value" != *$'\r'* ]] || fail "the value has a carriage return; nothing was changed"
    ((${#value} <= 4096)) || fail "the value is longer than 4096 characters; nothing was changed"
    write_key "$key" "$value"
    logger -t project-secret -- "project=$project set=$key by=${SUDO_USER:-root}"
    propagate "$key"
    if [[ -n "$(consumers_of "$key")" ]]; then
      echo "Set $key for $project and copied it to the backends that link to it. Restarting them:"
      restart_with_consumers "$key"
    else
      echo "Set $key for $project. It reaches the container at the next deploy, or now: sudo backend-rollback $project --restart"
    fi
    ;;
  unset)
    backend_lock "$project"
    has_value "$key" || fail "$key has no value"
    write_key "$key"
    logger -t project-secret -- "project=$project unset=$key by=${SUDO_USER:-root}"
    propagate "$key"
    echo "Removed $key from $project. It leaves the container at the next deploy, or now: sudo backend-rollback $project --restart"
    shared="$(consumers_of "$key" | awk '{print $1}' | paste -sd, -)"
    [[ -z "$shared" ]] || echo "It was also removed from the copies of $shared, which cannot be deployed or restarted until it has a value again."
    ;;
  generate)
    [[ "$(declared_kind "$key")" == generated ]] \
      || fail "$key is not declared in projects.yml as a generated secret of $project"
    backend_lock "$project"
    if has_value "$key"; then
      echo "exists"
      exit 0
    fi
    value="$(openssl rand -hex 32)"
    [[ "$value" =~ ^[0-9a-f]{64}$ ]] || fail "openssl did not produce a value"
    write_key "$key" "$value"
    logger -t project-secret -- "project=$project generated=$key"
    propagate "$key"
    echo "generated"
    ;;
  rotate)
    [[ "$(declared_kind "$key")" == generated ]] \
      || fail "$key is not declared in projects.yml as a generated secret of $project (a manual one changes with set)"
    backend_lock "$project"
    has_value "$key" || fail "$key has no value yet: run the playbook, which generates it"
    value="$(openssl rand -hex 32)"
    [[ "$value" =~ ^[0-9a-f]{64}$ ]] || fail "openssl did not produce a value"
    write_key "$key" "$value"
    logger -t project-secret -- "project=$project rotated=$key by=${SUDO_USER:-root}"
    propagate "$key"
    echo "Rotated $key for $project. Restarting it and the backends that link to it:"
    restart_with_consumers "$key"
    ;;
  sync)
    backend_lock "$project"
    backend_sync_links "$project"
    ;;
esac
