{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker:*)",
      "Bash(dockerd:*)",
      "Bash(ansible-playbook:*)",
      "Bash(tests/*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Read(/terraform/.env)",
      "Read(**/*.tfvars)",
      "Read(~/.ssh/**)"
    ]
  }
}
